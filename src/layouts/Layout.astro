---
import { SEO } from "astro-seo";
import { site } from "../config/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL | null;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title = site.title,
  description = site.description,
  canonical: canonicalProp = null,
  noindex = false,
  nofollow = false,
} = Astro.props;

// Canonical par défaut = origine officielle du site + chemin de la page
// courante (jamais Astro.url complet, qui donnerait localhost en dev).
// Avant ce correctif, toute page sans prop "canonical" explicite pointait
// à tort vers la racine du site (cf. /tarifs).
const currentPath =
  Astro.url.pathname === "/" ? "" : Astro.url.pathname.replace(/\/+$/, "");
const canonical = canonicalProp ?? `${site.canonical}${currentPath}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description: site.ogDescription,
  url: site.canonical,
  image: site.ogImage,
  telephone: site.telephone,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.city,
    postalCode: site.postalCode,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.coordinates.lat,
    longitude: site.coordinates.lon,
  },
  areaServed: {
    "@type": "State",
    name: "Occitanie",
  },
  priceRange: "€",
  founder: {
    "@type": "Person",
    name: site.author,
  },
  sameAs: Object.values(site.socials),
};

const showAnalytics = import.meta.env.PROD;

const gtagInlineScript = `window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag("js", new Date());gtag("config", "${site.gtagId}");`;
---

<!doctype html>
<html lang="fr">
  <head>
    <style define:vars={site.siteColors}></style>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO
      charset="UTF-8"
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      nofollow={nofollow}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: site.ogImage,
          url: canonical ?? site.canonical,
        },
        optional: {
          description: site.ogDescription,
          locale: site.locale,
          siteName: site.name,
        },
        image: {
          alt: site.ogImageAlt,
          height: 630,
          width: 1200,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description: site.twitterDescription,
        image: site.ogImage,
        imageAlt: site.ogImageAlt,
      }}
      extend={{
        link: [
          { rel: "icon", href: "/favicon.ico" },
          { rel: "apple-touch-icon", href: "/favicon.ico" },
          { rel: "preconnect", href: "https://fonts.googleapis.com" },
          {
            rel: "preconnect",
            href: "https://fonts.gstatic.com",
            crossorigin: "",
          },
          {
            rel: "stylesheet",
            href: "https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,600&display=swap",
          },
        ],
        meta: [{ name: "author", content: site.author }],
      }}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={site.siteColors.background} />
    <meta name="generator" content={Astro.generator} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    ></script>
    {showAnalytics && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${site.gtagId}`}
        ></script>
        <script is:inline set:html={gtagInlineScript}></script>
      </>
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      Aller au contenu principal
    </a>
    <Header />
    <main id="main-content" class="relative z-10 grow pt-[72px]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
