---
import { SEO } from "astro-seo";
import { site } from "../config/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { buildJsonLd } from "../utils/jsonld";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL | null;
  noindex?: boolean;
  nofollow?: boolean;
  pageType?: "WebPage" | "AboutPage" | "ContactPage" | "CollectionPage";
  breadcrumbs?: { name: string; path: string }[];
  faq?: { question: string; answer: string }[];
  services?: {
    name: string;
    description: string;
    serviceType?: string;
    price?: number;
  }[];
  extra?: Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  canonical: canonicalProp = null,
  noindex = false,
  nofollow = false,
  pageType,
  breadcrumbs,
  faq,
  services,
  extra,
} = Astro.props;

// Canonical par défaut = origine officielle du site + chemin de la page
// courante (jamais Astro.url complet, qui donnerait localhost en dev).
// Avant ce correctif, toute page sans prop "canonical" explicite pointait
// à tort vers la racine du site (cf. /tarifs).
const currentPath =
  Astro.url.pathname === "/" ? "" : Astro.url.pathname.replace(/\/+$/, "");
const canonical = canonicalProp ?? `${site.canonical}${currentPath}`;

const showAnalytics = import.meta.env.PROD;

const gtagInlineScript = `window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag("js", new Date());gtag("config", "${site.gtagId}");`;

const jsonLd = buildJsonLd({
  title,
  description,
  canonical: String(canonical),
  pageType,
  breadcrumbs,
  faq,
  services,
  extra,
});
---

<!doctype html>
<html lang="fr">
  <head>
    <style define:vars={site.colors}></style>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO
      charset="UTF-8"
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      nofollow={nofollow}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: site.ogImage,
          url: canonical ?? site.canonical,
        },
        optional: {
          description: site.ogDescription,
          locale: site.locale,
          siteName: site.name,
        },
        image: {
          alt: site.ogImageAlt,
          height: 630,
          width: 1200,
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description: site.twitterDescription,
        image: site.ogImage,
        imageAlt: site.ogImageAlt,
      }}
      extend={{
        link: [
          { rel: "icon", href: "/favicon.ico" },
          { rel: "apple-touch-icon", href: "/favicon.ico" },
        ],
        meta: [{ name: "author", content: site.author }],
      }}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={site.colors.background} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" is:inline set:html={jsonLd}></script>
    {showAnalytics && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${site.gtagId}`}
        ></script>
        <script is:inline set:html={gtagInlineScript}></script>
      </>
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      Aller au contenu principal
    </a>
    <Header />
    <main id="main-content" class="relative z-10 grow pt-[72px]">
      <slot />
    </main>
    <Footer />
    <script>
      // Repli pour les navigateurs sans `animation-timeline: view()` (Firefox
      // stable au 16/09/2026 : la timeline scroll-driven y est encore derrière
      // un flag).
      try {
        const supportsScrollTimeline =
          typeof CSS !== "undefined" &&
          typeof CSS.supports === "function" &&
          CSS.supports("animation-timeline", "view()");

        const revealables = document.querySelectorAll(".reveal-section");

        if (!supportsScrollTimeline && revealables.length > 0) {
          if ("IntersectionObserver" in window) {
            revealables.forEach((el) => el.classList.add("js-reveal"));

            const observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  entry.target.classList.toggle(
                    "is-visible",
                    entry.isIntersecting,
                  );
                }
              },
              { threshold: 0.2 },
            );

            revealables.forEach((el) => observer.observe(el));
          }
        }
      } catch (error) {
        console.error("Révélation de secours indisponible :", error);
        document
          .querySelectorAll(".reveal-section.js-reveal")
          .forEach((el) => el.classList.remove("js-reveal"));
      }
    </script>
  </body>
</html>
