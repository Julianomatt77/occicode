---
import Layout from "@/layouts/Layout.astro";
import Headline from "@/components/ui/Headline.astro";
import Button from "@/components/ui/Button.astro";
import { site } from "@/config/site";
import { existsSync } from "node:fs";
import { join } from "node:path";

const metadata = {
  title:
    "À propos d'OcciCode, création de site internet pour artisans et TPE en Occitanie",
  description:
    "Julien Martin, développeur indépendant basé à Péret (Hérault), conçoit des sites internet rapides et bien référencés pour les artisans et indépendants.",
  pageType: "AboutPage" as const,
  breadcrumbs: [{ name: "À propos", path: "/a-propos" }],
};

const photoSrc = "/assets/images/photo.JPG";
function photoExists(path: string): boolean {
  try {
    return existsSync(join(process.cwd(), "public", path));
  } catch {
    return false;
  }
}
const hasPhoto = photoExists(photoSrc);

// Carte OpenStreetMap centrée sur Péret (34800). En cas de coordonnées
// manquantes ou invalides dans la config, on masque simplement la carte
// plutôt que d'afficher un iframe cassé.
const { lat, lon } = site.coordinates;
const hasValidCoordinates = Number.isFinite(lat) && Number.isFinite(lon);

const mapDelta = 0.01;
const mapBbox = hasValidCoordinates
  ? `${lon - mapDelta},${lat - mapDelta * 0.75},${lon + mapDelta},${lat + mapDelta * 0.75}`
  : "";
const mapEmbedSrc = hasValidCoordinates
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${mapBbox}&layer=mapnik&marker=${lat},${lon}`
  : "";
const mapLinkHref = hasValidCoordinates
  ? `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=14/${lat}/${lon}`
  : "";
---

<Layout {...metadata}>
  <section
    class="mx-auto max-w-6xl scroll-mt-[72px] px-4 py-12 sm:px-6 md:py-20"
    id="section-a-propos"
  >
    <Headline
      tagline={site.aPropos.tagline}
      title={site.aPropos.title}
      subtitle={site.aPropos.subtitle}
      titleAs="h1"
      classes={{
        container: "max-w-3xl",
        title: "text-3xl md:text-4xl",
      }}
    />

    <div
      class:list={[
        "mt-10 items-center gap-8 md:gap-12",
        hasPhoto
          ? "grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]"
          : "mx-auto max-w-3xl",
      ]}
    >
      {hasPhoto && (
        <img
          src={photoSrc}
          alt="Julien Martin, développeur web indépendant à Péret"
          width="800"
          height="1000"
          class="aspect-4/5 w-full rounded-3xl object-cover"
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="glass-strong space-y-6 rounded-3xl p-6 text-muted-foreground md:p-10">
        <p>
          Je m'appelle Julien Martin. Je conçois et développe des sites internet
          pour les artisans, commerçants et indépendants, depuis Péret, dans
          l'Hérault.
        </p>
        <p>
          Mon objectif est simple : vous donner un site clair, rapide et facile
          à faire évoluer, sans fonctionnalités inutiles qui ralentissent le
          chargement ou compliquent la maintenance. Les sites que je livre sont
          construits avec des technologies modernes et performantes, pensées
          pour le référencement et pour durer dans le temps.
        </p>
        <p>
          Je travaille en direct avec vous, du premier échange à la mise en
          ligne : pas d'intermédiaire, pas de jargon technique inutile. Vous
          savez toujours à quelle étape en est votre projet.
        </p>
        <p>
          Je me déplace partout en Occitanie et je travaille à distance avec des
          clients dans toute la France, selon ce qui vous convient le mieux.
        </p>
      </div>
    </div>

    {hasValidCoordinates && (
      <div class="glass-strong mx-auto mt-10 max-w-3xl rounded-3xl p-6 md:p-8">
        <h2 class="text-lg font-bold text-foreground">Basé à Péret (34800)</h2>
        <div class="mt-4 overflow-hidden rounded-2xl border border-border">
          <iframe
            src={mapEmbedSrc}
            title="Carte OpenStreetMap centrée sur Péret (34800), Hérault"
            class="h-[320px] w-full md:h-[400px]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <p class="mt-3 text-sm text-muted-foreground">
          <a
            href={mapLinkHref}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary hover:underline"
            title="Voir Péret en plus grand sur OpenStreetMap"
          >
            Voir la carte en plus grand sur OpenStreetMap
          </a>
        </p>
      </div>
    )}

    <div class="mx-auto mt-10 flex max-w-3xl flex-wrap gap-4">
      <Button
        href="/contact"
        variant="primary"
        title="Aller vers la page contact pour demander un devis gratuit"
        aria-label="Aller vers la page contact pour demander un devis gratuit"
      >
        Demander un devis gratuit
      </Button>
      <Button
        href="/tarifs"
        variant="secondary"
        title="Consulter la page des tarifs"
        aria-label="Voir les tarifs"
      >
        Voir les tarifs
      </Button>
    </div>
  </section>
</Layout>
