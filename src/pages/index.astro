---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import DemoShowcase from "@/components/DemoShowcase.astro";
import { site } from "@/config/site";
import { formatPhone, toNumber } from "@/utils/format";

const { hero, services, process, whyUs, areas, faq, cta } = site.home;
const packages = site.services;
const phoneDisplay = formatPhone(site.telephone);

// Les sources vidées dans la config ne doivent pas produire un <video> mort :
// on ne rend le lecteur que si au moins une URL est renseignée.
const heroVideo: { webm?: string; mp4?: string } | null =
  site.heroVideo.webm || site.heroVideo.mp4 ? site.heroVideo : null;

const metadata = {
  title: "Site internet pour artisans et TPE | OcciCode",
  faq: faq.items.map(({ question, answer }) => ({ question, answer })),
  services: packages.map((service) => ({
    name: service.name,
    description: service.description,
    price: toNumber(service.price),
  })),
};
---

<Layout {...metadata} fullBleedHero>
  <!-- Hero -->
  <section
    id="section-hero"
    class="relative isolate mb-4 min-h-svh overflow-hidden bg-muted"
  >
    <img
      src={site.heroImage}
      alt=""
      width="1919"
      height="1279"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-30 h-full w-full object-cover object-center"
    />
    {heroVideo && (
      <video
        id="hero-video"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center motion-reduce:hidden"
        width="1919"
        height="1279"
        autoplay
        muted
        loop
        playsinline
        aria-hidden="true"
        tabindex="-1"
        poster={site.heroImage}
      >
        {heroVideo.webm && <source src={heroVideo.webm} type="video/webm" />}
        {heroVideo.mp4 && <source src={heroVideo.mp4} type="video/mp4" />}
      </video>
    )}
    <div class="absolute inset-0 -z-10 bg-primary/10" aria-hidden="true"></div>
    <div
      class="absolute inset-x-0 top-0 -z-10 h-40 bg-linear-to-b from-black/60 via-black/40 to-transparent"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto flex min-h-svh max-w-7xl items-center px-4 pb-10 pt-24 sm:px-6 reveal-section animate-section-fade">
      <div class="glass-strong w-full max-w-3xl rounded-3xl p-6 md:p-10">
        <h1 class="text-3xl tracking-tight text-balance text-foreground md:text-4xl lg:text-5xl">
          {hero.title}
        </h1>
        <p class="mt-4 text-pretty text-lg text-foreground/80 md:text-xl">
          {hero.subtitle}
        </p>
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-foreground/80">
          {hero.trust.map((item) => (
            <li class="flex items-center gap-2">
              <Icon
                name="mdi:check"
                class="h-4 w-4 shrink-0 text-primary"
                aria-hidden="true"
              />
              {item}
            </li>
          ))}
        </ul>

        <p class="mt-8 text-sm text-foreground/80">
          Je vous réponds sous 48 h, sans engagement.
        </p>
        <div
          class="mt-6 flex flex-col gap-3 md:flex-row md:flex-nowrap"
          role="group"
          aria-label="Me contacter"
        >
          <Button
            href={`${site.canonical}/contact`}
            variant="primary"
            size="md"
            title="Demander un devis gratuit"
            aria-label="Demander un devis gratuit"
          >
            Demander un devis
          </Button>
          <a
            href={`tel:${site.telephone}`}
            class="inline-flex min-h-12 items-center gap-2 rounded-xl border border-border bg-white/70 px-4 font-semibold text-foreground transition-colors hover:border-primary/40 hover:text-primary"
            title={`Appeler OcciCode au ${phoneDisplay}`}
            aria-label={`Appeler OcciCode au ${phoneDisplay}`}
          >
            <Icon
              name="mdi:phone-outline"
              class="h-5 w-5 shrink-0 text-primary"
              aria-hidden="true"
            />
            {phoneDisplay}
          </a>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex min-h-12 items-center gap-2 rounded-xl border border-border bg-white/70 px-4 font-semibold text-foreground transition-colors hover:border-primary/40 hover:text-primary"
            title={`Envoyer un email à ${site.email}`}
            aria-label={`Envoyer un email à ${site.email}`}
          >
            <Icon
              name="mdi:email-outline"
              class="h-5 w-5 shrink-0 text-primary"
              aria-hidden="true"
            />
            <span class="break-all md:break-normal md:whitespace-nowrap">
              {site.email}
            </span>
          </a>
        </div>
      </div>
    </div>
    {heroVideo && <script is:inline>
      (function () {
        try {
          const v = document.getElementById("hero-video");
          const c = navigator.connection;
          const saveData = !!(c && c.saveData);
          const reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          if (v && (saveData || reduced)) v.remove();
        } catch {
          /* la vidéo est décorative : en cas d'erreur, l'image reste */
        }
      })();
    </script>}
  </section>

  <!-- Démos -->
  <DemoShowcase />

  <!-- Formules -->
  <section
    id="section-services"
    class="relative isolate mb-4 scroll-mt-[72px] overflow-hidden bg-linear-to-br from-primary/10 via-accent/15 to-background reveal-section animate-section-fade"
  >
    <div
      class="absolute -top-16 -left-16 -z-10 h-72 w-72 rounded-full bg-primary/25 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="absolute -right-10 bottom-0 -z-10 h-80 w-80 rounded-full bg-accent/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <h2 class="text-3xl tracking-tight text-balance text-foreground md:text-5xl">
        {services.title}
      </h2>
      <p class="mt-4 text-pretty text-lg text-muted-foreground">
        {services.subtitle}
      </p>

      <div class="grid gap-6 pt-10 md:grid-cols-3">
        {packages.map((pkg) => (
          <article class="glass-strong relative flex flex-col rounded-3xl p-8 transition-transform duration-300 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-xl font-bold text-foreground">{pkg.name}</h3>
              {pkg.badge && (
                <span class="rounded-md bg-primary px-2 py-0.5 text-xs font-semibold text-white">
                  {pkg.badge}
                </span>
              )}
            </div>
            <p class="mt-2 text-pretty text-sm text-muted-foreground">
              {pkg.description}
            </p>
            <p class="mt-6 flex items-baseline gap-1">
              <span class="text-sm text-muted-foreground">{pkg.from}</span>
              <span class="text-2xl font-bold text-foreground">
                {pkg.price}
              </span>
            </p>
            <ul class="mt-6 flex flex-1 flex-col gap-2 text-pretty text-sm text-muted-foreground">
              {pkg.features.slice(0, 3).map((feature) => (
                <li class="flex items-start gap-2">
                  <Icon
                    name="mdi:check"
                    class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                    aria-hidden="true"
                  />
                  {feature}
                </li>
              ))}
            </ul>
            <Button
              href="/tarifs#tarif-list"
              variant={pkg.isPopular ? "primary" : "secondary"}
              size="sm"
              class="mt-6 w-full"
              title={`Voir la formule ${pkg.name} et ce qu'elle contient`}
              aria-label={`Voir la formule ${pkg.name} et ce qu'elle contient`}
            >
              Voir cette formule
            </Button>
          </article>
        ))}
      </div>

      <p class="mt-8 text-pretty text-sm text-muted-foreground">
        Le code, le contenu et le nom de domaine restent les vôtres. La
        maintenance est optionnelle.
      </p>
    </div>
  </section>

  <!-- Processus -->
  <section
    id="section-process"
    class="relative isolate mb-4 scroll-mt-[72px] reveal-section animate-section-fade"
  >
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <h2 class="max-w-2xl text-3xl tracking-tight text-balance text-foreground md:text-5xl">
        {process.title}
      </h2>
      <p class="mt-4 max-w-2xl text-pretty text-lg text-muted-foreground">
        {process.subtitle}
      </p>

      <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-0">
        {process.steps.map((step, index) => (
          <li class="relative border-l-2 border-border pl-5 md:border-l-0 md:border-t-2 md:pt-6 md:pr-8 md:pl-0">
            <span
              class="absolute -left-[5px] top-1 h-2 w-2 rounded-full bg-primary md:-top-[5px] md:left-0"
              aria-hidden="true"
            ></span>
            <p class="text-sm font-semibold text-primary">Étape {index + 1}</p>
            <h3 class="mt-1 text-lg font-bold text-foreground">{step.title}</h3>
            <p class="mt-2 text-pretty text-sm text-muted-foreground">
              {step.description}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Pourquoi OcciCode -->
  <section
    id="section-why-us"
    class="relative isolate mb-4 scroll-mt-[72px] bg-linear-to-bl from-accent/15 via-background to-primary/10 reveal-section animate-section-fade"
  >
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
        <div>
          <h2 class="max-w-md text-3xl tracking-tight text-balance text-foreground md:text-5xl">
            {whyUs.title}
          </h2>
          <p class="mt-4 max-w-md text-pretty text-lg text-muted-foreground">
            {whyUs.subtitle}
          </p>
        </div>

        <dl class="divide-y divide-border border-y border-border">
          {whyUs.points.map((point) => (
            <div class="grid gap-2 py-5 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-6">
              <dt class="font-bold text-foreground">{point.title}</dt>
              <dd class="text-pretty text-sm text-muted-foreground">
                {point.description}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Zone d'intervention -->
  <section
    id="section-areas"
    class="relative isolate mb-4 scroll-mt-[72px] reveal-section animate-section-fade"
  >
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
        <div>
          <h2 class="max-w-xl text-3xl tracking-tight text-balance text-foreground md:text-5xl">
            {areas.title}
          </h2>
          <p class="mt-4 max-w-xl text-pretty text-lg text-muted-foreground">
            {areas.subtitle}
          </p>

          <ul
            class="flex flex-wrap gap-3 pt-8"
            aria-label="Villes d'intervention, chaque ville mène à sa page Wikipédia"
          >
            {areas.cities.map((city) => (
              <li>
                <a
                  href={city.wikipedia}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex min-h-11 items-center rounded-full border border-border bg-muted/60 px-4 text-sm text-foreground underline-offset-4 transition-colors hover:bg-muted hover:underline"
                >
                  {city.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <img
          src={site.interventionAreaImage}
          alt="Une carte papier et une épingle, pour illustrer les interventions d'OcciCode en Occitanie"
          width="639"
          height="479"
          class="h-auto w-full rounded-2xl border border-border/60 shadow-sm"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section
    id="section-faq"
    class="relative isolate mb-4 scroll-mt-[72px] bg-linear-to-b from-background via-accent/10 to-primary/10 reveal-section animate-section-fade"
  >
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 md:py-16">
      <h2 class="max-w-2xl text-3xl tracking-tight text-balance text-foreground md:text-5xl">
        {faq.title}
      </h2>
      <p class="mt-4 max-w-2xl text-pretty text-lg text-muted-foreground">
        {faq.subtitle}
      </p>

      <div class="glass-strong mt-10 rounded-3xl px-6">
        {faq.items.map((item) => (
          <details class="group border-b border-border last:border-b-0">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-4 font-bold text-foreground [&::-webkit-details-marker]:hidden">
              <span>{item.question}</span>
              <Icon
                name="mdi:chevron-down"
                class="h-5 w-5 shrink-0 text-primary transition-transform group-open:rotate-180"
                aria-hidden="true"
              />
            </summary>
            <p class="max-w-3xl pb-4 text-pretty text-sm text-muted-foreground">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section
    id="section-contact"
    class="relative isolate mb-4 scroll-mt-[72px] reveal-section animate-section-fade"
  >
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 md:py-16">
      <div class="relative isolate overflow-hidden rounded-3xl bg-primary px-6 py-10 text-background md:px-12 md:py-14">
        <div
          class="absolute -right-16 -top-16 -z-10 h-72 w-72 rounded-full bg-accent/50 blur-3xl"
          aria-hidden="true"
        ></div>
        <h2 class="max-w-3xl text-2xl text-balance md:text-4xl">{cta.title}</h2>
        <p class="mt-3 max-w-2xl text-background/80">{cta.subtitle}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button
            href={`${site.canonical}/contact`}
            variant="secondary"
            size="lg"
            title="Demander un devis gratuit"
            aria-label="Demander un devis gratuit"
          >
            Demander un devis
          </Button>
          <a
            href={`tel:${site.telephone}`}
            class="inline-flex min-h-14 items-center gap-2 rounded-xl border border-background/30 px-5 font-semibold text-background transition-colors hover:bg-background/10"
            title={`Appeler OcciCode au ${phoneDisplay}`}
            aria-label={`Appeler OcciCode au ${phoneDisplay}`}
          >
            <Icon name="mdi:phone-outline" class="h-5 w-5" aria-hidden="true" />
            {phoneDisplay}
          </a>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex min-h-14 items-center gap-2 rounded-xl border border-background/30 px-5 font-semibold text-background transition-colors hover:bg-background/10"
            title={`Envoyer un email à ${site.email}`}
            aria-label={`Envoyer un email à ${site.email}`}
          >
            <Icon name="mdi:email-outline" class="h-5 w-5" aria-hidden="true" />
            {site.email}
          </a>
        </div>

        <p class="mt-8 text-sm text-background/70">
          Julien Martin, {site.city} ({site.postalCode}), {site.region}.
        </p>
      </div>
    </div>
  </section>
</Layout>
