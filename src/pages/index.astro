---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import DemoShowcase from "@/components/DemoShowcase.astro";
import { site } from "@/config/site";
import { formatPhone, toNumber } from "@/utils/format";

const { hero, services, process, whyUs, areas, faq, cta } = site.home;
const packages = site.services;
const phoneDisplay = formatPhone(site.telephone);

const contactPaths = [
  {
    label: "Demander un devis",
    href: "/contact",
    kind: "button",
    variant: "primary" as const,
  },
  {
    label: phoneDisplay,
    href: `tel:${site.telephone}`,
    kind: "tel",
    variant: "secondary" as const,
  },
  {
    label: "contact@occicode.fr",
    href: `mailto:${site.email}`,
    kind: "email",
    variant: "secondary" as const,
  },
];

const metadata = {
  title: "Site internet pour artisans et TPE | OcciCode",
  faq: faq.items.map(({ question, answer }) => ({ question, answer })),
  services: packages.map((service) => ({
    name: service.name,
    description: service.description,
    price: toNumber(service.price),
  })),
};
---

<Layout {...metadata}>
  <!-- Hero -->
  <section
    id="section-hero"
    class="relative isolate mb-4 scroll-mt-[72px] overflow-hidden bg-muted"
  >
    <img
      src={site.heroImage}
      alt=""
      width="1919"
      height="1279"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    />
    <div
      class="absolute inset-0 -z-10 bg-background/88 lg:hidden"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 -z-10 hidden bg-linear-to-r from-background from-0% via-background/95 via-55% to-background/25 lg:block"
      aria-hidden="true"
    ></div>

    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 md:py-16">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-start lg:gap-16">
        <div class="flex flex-col items-start gap-6">
          <h1 class="max-w-2xl text-3xl font-bold tracking-tight text-balance text-foreground md:text-4xl lg:text-5xl">
            {hero.title}
          </h1>
          <p class="max-w-2xl text-pretty text-lg text-muted-foreground md:text-xl">
            {hero.subtitle}
          </p>
          <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted-foreground">
            {hero.trust.map((item) => (
              <li class="flex items-center gap-2">
                <Icon
                  name="mdi:check"
                  class="h-4 w-4 shrink-0 text-primary"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))}
          </ul>
        </div>

        <aside
          class="rounded-3xl border border-border bg-card p-6 shadow-sm md:p-8"
          aria-labelledby="hero-contact-title"
        >
          <h2 id="hero-contact-title" class="text-xl font-bold text-foreground">
            Parlons de votre projet
          </h2>
          <p class="mt-2 text-pretty text-sm text-muted-foreground">
            Je vous réponds sous 48 h, sans engagement.
          </p>

          <div class="mt-6 flex flex-col gap-3">
            <Button
              href="/contact"
              variant="primary"
              size="md"
              class="w-full"
              title="Demander un devis gratuit"
              aria-label="Demander un devis gratuit"
            >
              Demander un devis
            </Button>
            <a
              href={`tel:${site.telephone}`}
              class="flex min-h-12 items-center gap-3 rounded-xl border border-border px-4 font-semibold text-foreground transition-colors hover:border-primary/40 hover:text-primary"
              title={`Appeler OcciCode au ${phoneDisplay}`}
              aria-label={`Appeler OcciCode au ${phoneDisplay}`}
            >
              <Icon
                name="mdi:phone-outline"
                class="h-5 w-5 shrink-0 text-primary"
                aria-hidden="true"
              />
              {phoneDisplay}
            </a>
            <a
              href={`mailto:${site.email}`}
              class="flex min-h-12 items-center gap-3 rounded-xl border border-border px-4 font-semibold text-foreground transition-colors hover:border-primary/40 hover:text-primary"
              title={`Envoyer un email à ${site.email}`}
              aria-label={`Envoyer un email à ${site.email}`}
            >
              <Icon
                name="mdi:email-outline"
                class="h-5 w-5 shrink-0 text-primary"
                aria-hidden="true"
              />
              {site.email}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Démos -->
  <DemoShowcase />

  <!-- Formules -->
  <section
    id="section-services"
    class="relative isolate mb-4 scroll-mt-[72px] bg-muted"
  >
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <h2 class="text-3xl font-bold tracking-tight text-balance text-foreground md:text-4xl">
        {services.title}
      </h2>
      <p class="mt-4 text-pretty text-lg text-muted-foreground">
        {services.subtitle}
      </p>

      <div class="grid gap-6 pt-10 md:grid-cols-3">
        {packages.map((pkg) => (
          <article
            class={`relative flex flex-col rounded-3xl border p-8 transition-shadow duration-300 hover:shadow-lg ${
              pkg.isPopular
                ? "border-primary/40 bg-primary/5 shadow-sm"
                : "border-border/60 bg-card shadow-sm"
            }`}
          >
            {pkg.badge && (
              <span class="absolute -top-3 right-8 inline-flex items-center rounded-full bg-primary px-3 py-1 text-xs font-semibold text-white">
                {pkg.badge}
              </span>
            )}
            <h3 class="text-xl font-bold text-foreground">{pkg.name}</h3>
            <p class="mt-2 text-pretty text-sm text-muted-foreground">
              {pkg.description}
            </p>
            <p class="mt-6 flex items-baseline gap-1">
              <span class="text-sm text-muted-foreground">{pkg.from}</span>
              <span class="text-2xl font-extrabold text-foreground">
                {pkg.price}
              </span>
            </p>
            <ul class="mt-6 flex flex-1 flex-col gap-2 text-pretty text-sm text-muted-foreground">
              {pkg.features.slice(0, 3).map((feature) => (
                <li class="flex items-start gap-2">
                  <Icon
                    name="mdi:check"
                    class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                    aria-hidden="true"
                  />
                  {feature}
                </li>
              ))}
            </ul>
            <Button
              href="/tarifs#tarif-list"
              variant={pkg.isPopular ? "primary" : "secondary"}
              size="sm"
              class="mt-6 w-full"
              title={`Voir la formule ${pkg.name} et ce qu'elle contient`}
              aria-label={`Voir la formule ${pkg.name} et ce qu'elle contient`}
            >
              Voir cette formule
            </Button>
          </article>
        ))}
      </div>

      <p class="mt-8 text-pretty text-sm text-muted-foreground">
        Le code, le contenu et le nom de domaine restent les vôtres. La
        maintenance est optionnelle.
      </p>
    </div>
  </section>

  <!-- Processus -->
  <section id="section-process" class="relative isolate mb-4 scroll-mt-[72px]">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <h2 class="max-w-2xl text-3xl font-bold tracking-tight text-balance text-foreground md:text-4xl">
        {process.title}
      </h2>
      <p class="mt-4 max-w-2xl text-pretty text-lg text-muted-foreground">
        {process.subtitle}
      </p>

      <ol class="grid gap-8 pt-10 md:grid-cols-3">
        {process.steps.map((step, index) => (
          <li class="flex flex-col gap-3">
            <span
              class="text-4xl font-extrabold text-primary/70"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="text-lg font-bold text-foreground">{step.title}</h3>
            <p class="text-pretty text-sm text-muted-foreground">
              {step.description}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Pourquoi OcciCode -->
  <section
    id="section-why-us"
    class="relative isolate mb-4 scroll-mt-[72px] bg-muted"
  >
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
        <div>
          <h2 class="max-w-md text-3xl font-bold tracking-tight text-balance text-foreground md:text-4xl">
            {whyUs.title}
          </h2>
          <p class="mt-4 max-w-md text-pretty text-lg text-muted-foreground">
            {whyUs.subtitle}
          </p>
        </div>

        <dl class="divide-y divide-border border-y border-border">
          {whyUs.points.map((point) => (
            <div class="grid gap-2 py-5 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-6">
              <dt class="font-bold text-foreground">{point.title}</dt>
              <dd class="text-pretty text-sm text-muted-foreground">
                {point.description}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Zone d'intervention -->
  <section id="section-areas" class="relative isolate mb-4 scroll-mt-[72px]">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
        <div>
          <h2 class="max-w-xl text-3xl font-bold tracking-tight text-balance text-foreground md:text-4xl">
            {areas.title}
          </h2>
          <p class="mt-4 max-w-xl text-pretty text-lg text-muted-foreground">
            {areas.subtitle}
          </p>

          <ul
            class="flex flex-wrap gap-3 pt-8"
            aria-label="Villes et secteurs d'intervention"
          >
            {areas.cities.map((city) => (
              <li class="rounded-full border border-border bg-muted/60 px-4 py-2 text-sm text-foreground">
                {city}
              </li>
            ))}
          </ul>
        </div>

        <img
          src={site.interventionAreaImage}
          alt="Une carte papier et une épingle, pour illustrer les interventions d'OcciCode en Occitanie"
          width="639"
          height="479"
          class="h-auto w-full rounded-2xl border border-border/60 shadow-sm"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section
    id="section-faq"
    class="relative isolate mb-4 scroll-mt-[72px] bg-muted"
  >
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 md:py-16">
      <h2 class="max-w-2xl text-3xl font-bold tracking-tight text-balance text-foreground md:text-4xl">
        {faq.title}
      </h2>
      <p class="mt-4 max-w-2xl text-pretty text-lg text-muted-foreground">
        {faq.subtitle}
      </p>

      <div class="mt-10 border-y border-border">
        {faq.items.map((item) => (
          <details class="group border-b border-border last:border-b-0">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-4 font-bold text-foreground [&::-webkit-details-marker]:hidden">
              <span>{item.question}</span>
              <Icon
                name="mdi:chevron-down"
                class="h-5 w-5 shrink-0 text-primary transition-transform group-open:rotate-180"
                aria-hidden="true"
              />
            </summary>
            <p class="max-w-3xl pb-4 text-pretty text-sm text-muted-foreground">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="section-contact" class="relative isolate mb-4 scroll-mt-[72px]">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 md:py-16">
      <div class="rounded-3xl bg-foreground px-6 py-10 text-background md:px-12 md:py-14">
        <h2 class="max-w-2xl text-2xl font-bold text-balance md:text-3xl">
          {cta.title}
        </h2>
        <p class="mt-3 max-w-2xl text-background/80">{cta.subtitle}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button
            href="/contact"
            variant="secondary"
            size="lg"
            title="Demander un devis gratuit"
            aria-label="Demander un devis gratuit"
          >
            Demander un devis
          </Button>
          <a
            href={`tel:${site.telephone}`}
            class="inline-flex min-h-14 items-center gap-2 rounded-xl border border-background/30 px-5 font-semibold text-background transition-colors hover:bg-background/10"
            title={`Appeler OcciCode au ${phoneDisplay}`}
            aria-label={`Appeler OcciCode au ${phoneDisplay}`}
          >
            <Icon name="mdi:phone-outline" class="h-5 w-5" aria-hidden="true" />
            {phoneDisplay}
          </a>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex min-h-14 items-center gap-2 rounded-xl border border-background/30 px-5 font-semibold text-background transition-colors hover:bg-background/10"
            title={`Envoyer un email à ${site.email}`}
            aria-label={`Envoyer un email à ${site.email}`}
          >
            <Icon name="mdi:email-outline" class="h-5 w-5" aria-hidden="true" />
            {site.email}
          </a>
        </div>

        <p class="mt-8 text-sm text-background/70">
          Julien Martin, {site.city} ({site.postalCode}), {site.region}.
        </p>
      </div>
    </div>
  </section>
</Layout>
