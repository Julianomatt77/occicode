---
import Layout from "@/layouts/Layout.astro";
import Headline from "@/components/ui/Headline.astro";
import { site } from "@/config/site";
import Button from "@/components/ui/Button.astro";

const page = site.realisations;
const metadata = {
  title:
    "Sites vitrine (restaurant, paysagiste, menuisier) réalisés par OcciCode",
  description:
    "Sites vitrine (restaurant, paysagiste, menuisier) pour vous projeter.",
  pageType: "CollectionPage" as const,
  breadcrumbs: [{ name: "Réalisations", path: "/realisations" }],
  extra: [
    {
      "@type": "ItemList",
      itemListElement: page.sections.map((section, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "CreativeWork",
          name: section.title,
          description: section.text,
          url: section.href,
          image: site.canonical + section.image,
        },
      })),
    },
  ],
};
---

<Layout {...metadata}>
  <section
    class="relative isolate scroll-mt-[72px] mb-4 reveal-section animate-section-fade"
    id="section-realisations"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-6 py-8 md:py-12 not-prose text-default">
      <Headline
        tagline={site.realisations.tagline}
        title={site.realisations.title}
        subtitle={site.realisations.subtitle}
        titleAs="h1"
      />
    </div>
  </section>

  {page.sections.map((section, index) => {
    const imageFirst = index % 2 === 0;
    return (
      <section
        class:list={[
          "reveal-section relative isolate mb-4 grid scroll-mt-[72px] md:min-h-[max(40rem,85svh)] md:grid-cols-2",
          imageFirst
            ? "bg-linear-to-br from-primary/10 via-background to-accent/15"
            : "bg-linear-to-bl from-accent/15 via-background to-primary/10",
        ]}
      >
        <div
          class:list={[
            "flex items-center justify-center px-6 py-10 md:px-10 md:py-16",
            { "md:order-2": !imageFirst },
          ]}
        >
          <div class="relative w-full max-w-3xl">
            <img
              src={section.image}
              alt={section.imageAlt}
              width={section.imageWidth}
              height={section.imageHeight}
              class="h-auto w-full rounded-2xl border border-white/70 shadow-2xl shadow-primary/20"
              loading="lazy"
              decoding="async"
            />
            <span class="glass-strong absolute bottom-3 left-3 rounded-full px-3 py-1 text-sm font-semibold text-foreground">
              Site de démonstration
            </span>
          </div>
        </div>

        <article class="flex items-center px-6 py-16 md:px-12 lg:px-20">
          <div class="max-w-md">
            <h2 class="text-3xl font-semibold text-foreground md:text-4xl">
              {section.title}
            </h2>
            <p class="mt-5 leading-relaxed text-muted-foreground">
              {section.text}
            </p>
            <Button
              href={section.href}
              rel="noopener noreferrer"
              target="_blank"
              variant="primary"
              size="sm"
              class="mt-6"
              title={`Voir la démo ${section.title} dans un nouvel onglet`}
              aria-label={`Voir la démo ${section.title} dans un nouvel onglet`}
            >
              Voir la démo
            </Button>
          </div>
        </article>
      </section>
    );
  })}
</Layout>
