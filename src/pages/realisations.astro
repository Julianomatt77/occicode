---
import Layout from "@/layouts/Layout.astro";
import Headline from "@/components/ui/Headline.astro";
import { site } from "@/config/site";
import Button from "@/components/ui/Button.astro";

const page = site.realisations;
const metadata = {
  title: "OcciCode - Réalisations",
  description:
    "Démos de sites vitrine réalisés par OcciCode pour des artisans et indépendants d'Occitanie.",
  pageType: "CollectionPage" as const,
  breadcrumbs: [{ name: "Réalisations", path: "/realisations" }],
  extra: [
    {
      "@type": "ItemList",
      itemListElement: page.sections.map((section, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "CreativeWork",
          name: section.title,
          description: section.text,
          url: section.href,
          image: section.image,
        },
      })),
    },
  ],
};
---

<Layout {...metadata}>
  <section
    class="relative isolate scroll-mt-[72px] mb-4 reveal-section animate-section-fade"
    id="section-realisations"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-6 py-8 md:py-12 not-prose text-default">
      <Headline
        tagline={site.realisations.tagline}
        title={site.realisations.title}
        subtitle={site.realisations.subtitle}
        titleAs="h1"
      />
    </div>
  </section>

  {page.sections.map((section, index) => (
    <section class="reveal-section scroll-mt-[73px] my-12 md:my-0 md:mx-12">
      <article
        class:list={[
          "bg-muted grid w-full max-w-6xl grid-cols-1 items-center gap-16 md:grid-cols-12 my-4 rounded-4xl overflow-hidden",
          index % 2 === 0 ? "md:mr-auto" : "md:ml-auto",
          { "md:[&>*:first-child]:order-2": index % 2 === 1 },
        ]}
      >
        <div class="md:col-span-6 px-8 py-12 xl:px-32 mb-4 md:mb-0">
          <h2 class="font-display text-3xl font-semibold text-foreground md:text-4xl">
            {section.title}
          </h2>
          <p class="mt-5 max-w-md leading-relaxed text-muted-foreground">
            {section.text}
          </p>
          <Button
            href={section.href}
            target="_blank"
            variant="primary"
            size="sm"
            class="mt-4 w-full"
            title={`Aller sur le site ${section.href}`}
            aria-label={`Aller sur le site ${section.href}`}
          >
            Voir la démo
          </Button>
        </div>

        <div
          class:list={["md:col-span-6", { "mb-4 md:mb-0": index % 2 === 1 }]}
        >
          <img
            src={section.image}
            alt={section.imageAlt}
            width="700"
            height="880"
            class="aspect-4/3 w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </article>
    </section>
  ))}
</Layout>
