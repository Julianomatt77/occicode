---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
// import CallToAction from "@/components/widgets/CallToAction.astro";
import { site } from "@/config/site";
import Button from "@/components/ui/Button.astro";
import Headline from "@/components/ui/Headline.astro";
import type { Feature } from "@/types/types";
import { toNumber } from "@/utils/format.ts";

const pricingHeadline = site.tarifs;
const services = site.services;
const features = site.includedFeatures.features;
const includedFeatures = site.includedFeatures;
const faq = site.faqItems;
const faqItems = site.faqItems.items;

const metadata = {
  title: `Tarifs de création de site internet, dès ${site.services[0].price} | OcciCode`,
  description: `Formules de création de site internet pour artisans et PME, à partir de ${site.services[0].price}.`,
  pageType: "CollectionPage" as const,
  breadcrumbs: [{ name: "Tarifs", path: "/tarifs" }],
  services: services.map((service) => ({
    name: service.name,
    description: service.description,
    price: toNumber(service.price),
  })),
  faq: faqItems.map(({ question, answer }) => ({
    question,
    // les réponses contiennent du HTML (set:html) : on le retire pour le schema
    answer: answer.replace(/<[^>]+>/g, "").trim(),
  })),
};
---

<Layout {...metadata}>
  <section
    class="relative isolate scroll-mt-[72px] mb-4 reveal-section animate-section-fade"
    id="section-pricing"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-6 py-8 md:py-12 not-prose text-default">
      <Headline
        title={pricingHeadline.title}
        subtitle={pricingHeadline.subtitle}
        tagline={pricingHeadline.tagline}
        titleAs="h1"
      />

      <div
        class="grid scroll-mt-[72px] gap-8 md:grid-cols-3 md:gap-6 lg:gap-8 items-stretch pt-12 md:pt-20"
        id="tarif-list"
      >
        {services.map((service) => (
          <article class="glass-strong relative flex flex-col rounded-3xl p-8 transition-transform duration-300 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
            <div class="mb-6">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-2xl font-bold">{service.name}</h3>
                {service.badge && (
                  <span class="rounded-md bg-primary px-2 py-0.5 text-xs font-semibold text-white">
                    {service.badge}
                  </span>
                )}
              </div>
              <p class="mt-2 text-muted-foreground">{service.description}</p>
            </div>

            <div class="mb-8 flex items-baseline text-foreground">
              <span class="text-muted-foreground mx-2">{service.from}</span>
              <span class="text-5xl font-bold tracking-tight">
                {service.price}
              </span>
            </div>

            <ul class="mb-8 flex-1 space-y-4">
              {service.features.map((feature) => (
                <li class="flex items-start">
                  <Icon
                    name="mdi:check"
                    class="h-5 w-5 shrink-0 text-primary mt-0.5"
                    aria-hidden="true"
                  />
                  <span class="ml-3 text-muted-foreground">{feature}</span>
                </li>
              ))}
            </ul>

            <Button
              href={`${site.canonical}/contact?objet=${encodeURIComponent(service.name)}`}
              variant={service.isPopular ? "primary" : "secondary"}
              class="w-full"
              title={`Demander un devis pour la formule ${service.name}`}
              aria-label={`Demander un devis pour la formule ${service.name}`}
            >
              {service.buttonText}
            </Button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    class="relative isolate mb-4 scroll-mt-[72px] overflow-hidden bg-linear-to-bl from-accent/15 via-background to-primary/10 reveal-section animate-section-fade"
    id="section-included-features"
  >
    <div
      class="absolute -top-16 left-1/4 -z-10 h-72 w-72 rounded-full bg-accent/30 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-6 py-12 md:py-20 not-prose text-default">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.4fr)] lg:items-start lg:gap-16">
        <Headline
          title={includedFeatures.title}
          subtitle={includedFeatures.subtitle}
          tagline={includedFeatures.tagline}
          classes={{ container: "max-w-xl" }}
        />

        <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {features.map((feat: Feature) => (
            <li class="border-t-2 border-border pt-5">
              <h3 class="text-lg font-bold text-foreground">{feat.title}</h3>
              <p class="mt-2 text-pretty text-sm text-muted-foreground">
                {feat.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section
    class="relative isolate scroll-mt-[72px] mb-4 reveal-section animate-section-fade"
    id="section-faq"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-6 py-12 md:py-20 not-prose text-default">
      <Headline
        title={faq.title}
        subtitle={faq.subtitle}
        tagline={faq.tagline}
      />

      <div class="grid sm:grid-cols-2 gap-8 md:gap-12 mt-8" id="faq-list">
        {faqItems &&
          faqItems.map(({ question, answer }) => (
            <article class="glass-strong flex flex-col rounded-3xl p-6">
              <h3 class="mb-3 text-xl font-bold flex items-start">
                <Icon
                  name="mdi:chevron-right"
                  class="w-6 h-6 text-primary shrink-0 mr-2 mt-0.5"
                  aria-hidden="true"
                />
                {question}
              </h3>
              {answer && (
                <div class="text-muted-foreground ml-8" set:html={answer} />
              )}
            </article>
          ))}
      </div>
    </div>
  </section>
</Layout>
