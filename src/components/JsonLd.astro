---
import { site } from "../config/site";

type Crumb = { name: string; path: string };
type Faq = { question: string; answer: string };
type ServiceInput = {
  name: string;
  description: string;
  serviceType?: string;
  price?: number; // prix "à partir de", en euros
};

interface Props {
  title: string;
  description: string;
  canonical: string;
  pageType?: "WebPage" | "AboutPage" | "ContactPage" | "CollectionPage";
  breadcrumbs?: Crumb[]; // sans l'accueil, ajouté automatiquement
  faq?: Faq[];
  services?: ServiceInput[];
  extra?: Record<string, unknown>[]; // nœuds libres supplémentaires
}

const {
  title,
  description,
  canonical,
  pageType = "WebPage",
  breadcrumbs = [],
  faq = [],
  services = [],
  extra = [],
} = Astro.props;

const origin = site.canonical.replace(/\/+$/, "");
const orgId = `${origin}/#organization`;
const personId = `${origin}/#person`;
const siteId = `${origin}/#website`;
const pageId = `${canonical}#webpage`;
const areaServed = [
  { "@type": "Country", name: "France" },
  { "@type": "AdministrativeArea", name: "Occitanie" },
  { "@type": "AdministrativeArea", name: "Hérault" },
  ...site.home.areas.cities.map((name) => ({ "@type": "City", name })),
];

// --- Nœuds globaux (présents sur toutes les pages) ---
const organization = {
  "@type": "ProfessionalService",
  "@id": orgId,
  name: site.name,
  description: site.ogDescription,
  url: origin,
  logo: {
    "@type": "ImageObject",
    url: site.logo_schema,
  },
  image: site.ogImage,
  telephone: site.telephone,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.city,
    postalCode: site.postalCode,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.coordinates.lat,
    longitude: site.coordinates.lon,
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    telephone: site.telephone,
    email: site.email,
    availableLanguage: "fr",
    areaServed: "FR",
  },
  areaServed: areaServed,
  knowsAbout: [
    "Création de site internet",
    "Site vitrine",
    "WordPress",
    "Référencement local (SEO)",
  ],
  priceRange: "€",
  founder: { "@id": personId },
  sameAs: Object.values(site.socials),
};

const person = {
  "@type": "Person",
  "@id": personId,
  name: site.author,
  jobTitle: "Développeur web",
  url: origin,
  worksFor: { "@id": orgId },
};

const website = {
  "@type": "WebSite",
  "@id": siteId,
  url: origin,
  name: site.name,
  inLanguage: "fr-FR",
  publisher: { "@id": orgId },
};

// --- Nœuds propres à la page ---
const webPage = {
  "@type": pageType,
  "@id": pageId,
  url: canonical,
  name: title,
  description,
  inLanguage: "fr-FR",
  isPartOf: { "@id": siteId },
  about: { "@id": orgId },
  ...(breadcrumbs.length > 0 && {
    breadcrumb: { "@id": `${canonical}#breadcrumb` },
  }),
};

const breadcrumbList =
  breadcrumbs.length > 0
    ? {
        "@type": "BreadcrumbList",
        "@id": `${canonical}#breadcrumb`,
        itemListElement: [{ name: "Accueil", path: "" }, ...breadcrumbs].map(
          (crumb, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: crumb.name,
            item: `${origin}${crumb.path}`,
          }),
        ),
      }
    : null;

const serviceNodes = services.map((service, index) => ({
  "@type": "Service",
  "@id": `${canonical}#service-${index + 1}`,
  name: service.name,
  description: service.description,
  serviceType: service.serviceType ?? service.name,
  provider: { "@id": orgId },
  areaServed: areaServed,
  ...(service.price !== undefined && {
    offers: {
      "@type": "Offer",
      priceCurrency: "EUR",
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: service.price,
        priceCurrency: "EUR",
      },
    },
  }),
}));

const faqNode =
  faq.length > 0
    ? {
        "@type": "FAQPage",
        "@id": `${canonical}#faq`,
        isPartOf: { "@id": pageId },
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }
    : null;

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    person,
    website,
    webPage,
    ...(breadcrumbList ? [breadcrumbList] : []),
    ...serviceNodes,
    ...(faqNode ? [faqNode] : []),
    ...extra,
  ],
};

// Échappe "<" pour éviter toute fermeture prématurée de la balise <script>
const json = JSON.stringify(graph).replace(/</g, "\\u003c");
---

<script type="application/ld+json" is:inline set:html={json}></script>
