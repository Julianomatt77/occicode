---
import { Icon } from "astro-icon/components";
import { site } from "@/config/site";

const demos = site.home.demos;
const projects = site.realisations.sections;
---

<section id="section-demos" class="relative isolate mb-4 scroll-mt-[72px]">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
    <h2 class="max-w-2xl text-3xl font-bold tracking-tight text-balance text-foreground md:text-4xl">
      {demos.title}
    </h2>
    <p class="mt-4 text-pretty text-lg text-muted-foreground">
      {demos.subtitle}
    </p>

    <ul class="grid gap-6 pt-10 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <li class="group relative flex flex-col overflow-hidden rounded-2xl border border-border/60 bg-card">
          <img
            src={project.image}
            alt={project.imageAlt}
            width="600"
            height="400"
            class="aspect-video w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-1 flex-col p-5">
            <span class="inline-flex w-fit items-center rounded-full border border-border px-2.5 py-1 text-xs font-semibold text-muted-foreground">
              Démo
            </span>
            <h3 class="mt-3 text-lg font-bold text-foreground">
              {project.title}
            </h3>
            <p class="mt-1 text-pretty text-sm text-muted-foreground">
              {project.text}
            </p>
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex min-h-11 items-center font-semibold text-primary after:absolute after:inset-0"
              title={`Voir la démo ${project.title}, ouverte dans un nouvel onglet`}
              aria-label={`Voir la démo ${project.title}, ouverte dans un nouvel onglet`}
            >
              Voir la démo
              <Icon
                name="mdi:arrow-top-right"
                class="ml-1 h-4 w-4"
                aria-hidden="true"
              />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
