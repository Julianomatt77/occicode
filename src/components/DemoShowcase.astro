---
import { Icon } from "astro-icon/components";
import { site } from "@/config/site";
---

<section
  id="section-demos"
  class="relative isolate mb-4 scroll-mt-[72px] reveal-section animate-section-fade"
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
    <h2 class="max-w-2xl text-3xl tracking-tight text-balance text-foreground md:text-5xl">
      {site.home.demos.title}
    </h2>
    <p class="mt-4 text-pretty text-lg text-muted-foreground">
      {site.home.demos.subtitle}
    </p>

    <ul class="grid gap-6 pt-10 sm:grid-cols-2 lg:grid-cols-3">
      {site.realisations.sections.map((project) => (
        <li class="group relative flex flex-col overflow-hidden rounded-2xl bg-card p-6 shadow-sm hover:shadow-md transition-shadow">
          <img
            src={project.image}
            alt={project.imageAlt}
            width="600"
            height="400"
            class="aspect-video w-full object-cover object-center rounded-t-lg mb-4"
            loading="lazy"
            decoding="async"
          />
          <span class="absolute top-2 left-2 rounded-full border border-white bg-primary px-2 py-1 text-xs font-semibold text-white">
            Démo
          </span>
          <h3 class="text-lg font-bold text-foreground">{project.title}</h3>
          <p class="text-sm text-muted-foreground">{project.text}</p>
          <a
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex min-h-11 items-center font-semibold text-primary after:absolute after:inset-0"
            title={`Voir la démo ${project.title} dans un nouvel onglet`}
            aria-label={`Voir la démo ${project.title} dans un nouvel onglet`}
          >
            Voir la démo
            <Icon
              name="mdi:arrow-top-right"
              class="ml-1 h-4 w-4"
              aria-hidden="true"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
