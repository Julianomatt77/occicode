---
interface Props {
  variant?: "primary" | "secondary" | "tertiary";
  size?: "sm" | "md" | "lg";
  href?: string;
  target?: "_blank" | "_self" | "_parent" | "_top";
  type?: "button" | "submit" | "reset";
  class?: string;
  "aria-label"?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  href,
  target,
  type = "button",
  class: className = "",
  "aria-label": ariaLabel,
  ...rest
} = Astro.props;

/* Anneau de focus visible : 3 px pour rester perceptible sur fond clair comme sur le panneau sombre.
   Doit gagner sur les utilitaires Tailwind (hors @layer). */
const focusVisible =
  "focus-visible:outline-2 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary";

const baseStyles =
  "inline-flex items-center justify-center font-bold transition-colors motion-reduce:transition-none disabled:opacity-50 disabled:pointer-events-none disabled:cursor-not-allowed rounded-xl " +
  focusVisible;

const variants = {
  primary:
    "bg-foreground/85 text-background hover:bg-foreground shadow-lg shadow-primary/15",
  secondary: "bg-muted text-foreground border border-border hover:bg-muted/80",
  tertiary:
    "bg-transparent text-foreground hover:bg-accent hover:text-accent-foreground",
};

const sizes = {
  sm: "min-h-11 px-4 py-2 text-sm",
  md: "min-h-12 px-6 py-3 text-base",
  lg: "min-h-14 px-8 py-4 text-lg",
};

const classes = [baseStyles, variants[variant], sizes[size], className].join(
  " ",
);

const Tag = href ? "a" : "button";
---

<Tag
  type={href ? undefined : type}
  href={href}
  target={target}
  class={classes}
  aria-label={ariaLabel}
  {...rest}
>
  <slot />
</Tag>
