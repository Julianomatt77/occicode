---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/Button.astro";
import { site } from "@/config/site";
import { formatPhone } from "@/utils/format";

interface Props {
  /** Hero plein écran derrière l'en-tête : texte clair tant qu'il est transparent. */
  overHero?: boolean;
}

const { overHero = false } = Astro.props;
const navLinks = site.navLinks;
const quoteHref = site.canonical + "/contact";
const phoneDisplay = formatPhone(site.telephone);
const pathname = Astro.url.pathname;

const isCurrent = (href: string) => {
  if (href.includes("#")) return false;
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header
  id="site-header"
  data-hero={overHero ? "" : undefined}
  class="group fixed inset-x-3 top-3 z-50 h-14 rounded-2xl sm:inset-x-6"
>
  <div
    class="glass-strong pointer-events-none absolute inset-0 -z-10 rounded-2xl transition-opacity duration-300 group-data-top:opacity-0 motion-reduce:transition-none"
    aria-hidden="true"
  ></div>
  <div class="mx-auto flex h-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="flex min-h-11 items-center gap-2 shrink-0"
      title="Retour à l'accueil OcciCode"
      aria-label="Retour à l'accueil OcciCode"
    >
      <img
        src={site.logo.logo_36x36}
        alt="Logo OcciCode"
        width="36"
        height="36"
        class="h-9 w-9 transition-colors group-data-light:rounded-lg group-data-light:bg-white/90 group-data-light:p-[3px]"
        loading="eager"
        decoding="async"
      />
      <span class="text-lg font-bold text-foreground group-data-light:text-white group-data-light:[text-shadow:0_1px_8px_rgb(0_0_0/0.6)]">
        {site.name}
      </span>
    </a>

    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm font-medium text-foreground group-data-light:text-white group-data-light:[text-shadow:0_1px_8px_rgb(0_0_0/0.6)]">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center transition-colors hover:text-primary aria-[current=page]:text-primary group-data-light:hover:text-white/80 group-data-light:aria-[current=page]:text-white group-data-light:aria-[current=page]:underline group-data-light:aria-[current=page]:underline-offset-8"
              title={link.text}
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden shrink-0 items-center gap-4 md:flex">
      <a
        href={`tel:${site.telephone}`}
        class="hidden min-h-11 items-center gap-2 text-sm font-semibold text-foreground transition-colors hover:text-primary group-data-light:text-white group-data-light:[text-shadow:0_1px_8px_rgb(0_0_0/0.6)] group-data-light:hover:text-white/80 lg:inline-flex"
        title={`Appeler OcciCode au ${phoneDisplay}`}
        aria-label={`Appeler OcciCode au ${phoneDisplay}`}
      >
        <Icon name="mdi:phone-outline" class="h-4 w-4" aria-hidden="true" />
        {phoneDisplay}
      </a>
      <Button
        href={quoteHref}
        variant="primary"
        size="sm"
        class="group-data-light:ring-1 group-data-light:ring-white/60"
        title="Demander un devis gratuit"
        aria-label="Demander un devis gratuit"
      >
        Devis gratuit
      </Button>
    </div>

    <details id="menu-mobile" class="group relative md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-border group-data-light:border-white/60 [&::-webkit-details-marker]:hidden"
        title="Ouvrir le menu"
        aria-label="Ouvrir le menu"
      >
        <Icon
          name="mdi:menu"
          class="h-5 w-5 text-foreground group-data-light:text-white group-open:hidden"
          aria-hidden="true"
        />
        <Icon
          name="mdi:close"
          class="hidden h-5 w-5 text-foreground group-data-light:text-white group-open:block"
          aria-hidden="true"
        />
      </summary>
      <div class="absolute right-0 top-full mt-2 w-64 rounded-xl border border-border bg-white p-4 shadow-lg">
        <ul class="flex flex-col text-sm font-medium text-foreground">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex min-h-11 items-center rounded-lg px-2 transition-colors hover:bg-muted hover:text-primary"
                title={link.text}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                onclick="this.closest('details')?.removeAttribute('open')"
              >
                {link.text}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-3 flex flex-col gap-2 border-t border-border pt-3">
          <a
            href={`tel:${site.telephone}`}
            class="flex min-h-11 items-center gap-2 rounded-lg px-2 text-sm font-semibold text-foreground transition-colors hover:bg-muted hover:text-primary"
            title={`Appeler OcciCode au ${phoneDisplay}`}
            aria-label={`Appeler OcciCode au ${phoneDisplay}`}
          >
            <Icon name="mdi:phone-outline" class="h-4 w-4" aria-hidden="true" />
            {phoneDisplay}
          </a>
          <a
            href={`mailto:${site.email}`}
            class="flex min-h-11 items-center gap-2 rounded-lg px-2 text-sm font-semibold text-foreground transition-colors hover:bg-muted hover:text-primary"
            title="Envoyer un email à OcciCode"
            aria-label={`Envoyer un email à ${site.email}`}
          >
            <Icon name="mdi:email-outline" class="h-4 w-4" aria-hidden="true" />
            Écrire un email
          </a>
          <Button
            href={quoteHref}
            variant="primary"
            size="sm"
            class="mt-1 w-full"
            title="Demander un devis gratuit"
            aria-label="Demander un devis gratuit"
          >
            Devis gratuit
          </Button>
        </div>
      </div>
    </details>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById("site-header");
    if (!header) return;

    // Sans JavaScript, le verre reste affiché en permanence : il n'est masqué
    // qu'en haut de page, une fois ce script exécuté.
    const overHero = header.hasAttribute("data-hero");

    const update = () => {
      const atTop = window.scrollY <= 8;
      header.toggleAttribute("data-top", atTop);
      // Texte clair seulement au-dessus du hero, tant que le verre est masqué.
      header.toggleAttribute("data-light", atTop && overHero);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
  })();
</script>

<script>
  const menu = document.getElementById(
    "menu-mobile",
  ) as HTMLDetailsElement | null;

  if (menu) {
    const summary = menu.querySelector("summary");

    const syncLabel = (open: boolean) => {
      const label = open ? "Fermer le menu" : "Ouvrir le menu";
      summary?.setAttribute("aria-label", label);
      summary?.setAttribute("title", label);
    };

    const releaseScroll = () => {
      document.documentElement.style.overflow = "";
    };

    menu.addEventListener("toggle", () => {
      syncLabel(menu.open);
      document.documentElement.style.overflow = menu.open ? "hidden" : "";
      if (menu.open) {
        menu.querySelector<HTMLElement>("a, button")?.focus();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      menu.open = false;
      summary?.focus();
    });

    document.addEventListener("click", (event) => {
      if (!menu.open) return;
      if (event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    });

    window.addEventListener("pagehide", releaseScroll);
  }
</script>
