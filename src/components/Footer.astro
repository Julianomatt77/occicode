---
import { Icon } from "astro-icon/components";
import { site } from "@/config/site";
import { formatPhone } from "@/utils/format";

const navLinks = site.navLinks;
const footerLinks = site.footerLinks;
const phoneDisplay = formatPhone(site.telephone);

// new Date() est fiable au build (SSG) : pas d'accès horloge côté client à sécuriser.
const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: "Facebook", href: site.socials.facebook, icon: "mdi:facebook" },
  { name: "Instagram", href: site.socials.instagram, icon: "mdi:instagram" },
].filter((link) => Boolean(link.href));
---

<footer class="border-t border-border bg-muted">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <a
        href="/"
        class="flex min-h-11 items-center gap-2"
        title="Retour à l'accueil OcciCode"
        aria-label="Retour à l'accueil OcciCode"
      >
        <img
          src={site.logo.logo_32x32}
          alt="Logo OcciCode"
          width="32"
          height="32"
          class="h-8 w-8"
          loading="lazy"
          decoding="async"
        />
        <span class="text-lg font-bold text-foreground">{site.name}</span>
      </a>
      <p class="mt-3 max-w-xs text-pretty text-sm text-muted-foreground">
        {site.footerTagline}
      </p>
      {socialLinks.length > 0 && (
        <ul class="mt-4 flex items-center gap-3">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                title={link.name}
                aria-label={`OcciCode sur ${link.name}`}
                class="flex h-11 w-11 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors hover:text-primary"
              >
                <Icon name={link.icon} class="h-4 w-4" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav aria-label="Navigation du pied de page">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-foreground">
        Navigation
      </h2>
      <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors hover:text-primary"
              title={link.text}
            >
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-foreground">
        Contact
      </h2>
      <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
        <li>
          <a
            href={`mailto:${site.email}`}
            class="transition-colors hover:text-primary"
            title="Envoyer un email à OcciCode"
          >
            {site.email}
          </a>
        </li>
        <li>
          <a
            href={`tel:${site.telephone}`}
            class="transition-colors hover:text-primary"
            title={`Appeler OcciCode au ${phoneDisplay}`}
          >
            {phoneDisplay}
          </a>
        </li>
        <li>
          {site.city} ({site.postalCode}), {site.region}
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 py-6 text-xs text-muted-foreground sm:flex-row sm:px-6">
      <p>
        &copy; {currentYear} {site.name}. Tous droits réservés.
      </p>
      {footerLinks.length > 0 && (
        <ul class="flex flex-wrap items-center justify-center gap-4">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex min-h-11 items-center transition-colors hover:text-primary"
                title={link.text}
              >
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</footer>
