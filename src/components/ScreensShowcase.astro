---
import Headline from "@/components/ui/Headline.astro";
import { site } from "@/config/site";

// Contenu piloté par la config ; valeurs de repli pour que la section ne casse
// jamais la page d'accueil si le bloc "screens" venait à disparaître de site.ts.
const screens = site?.home?.screens;
const tagline = screens?.tagline ?? "Sur tous les écrans";
const title = screens?.title ?? "Un site pensé pour chaque écran";
const subtitle =
  screens?.subtitle ??
  "Votre site s'adapte automatiquement au téléphone, à la tablette et à l'ordinateur.";
---

<section
  class="relative isolate scroll-mt-[72px] bg-muted bg-cover bg-center bg-no-repeat mb-4"
  id="section-screens"
>
  <div class="py-12 md:py-20 mx-auto max-w-7xl px-4 sm:px-6 md:px-6 reveal-section animate-section-fade">
    <Headline tagline={tagline} title={title} subtitle={subtitle} />

    <div
      class="flex items-end justify-center gap-[3%] pt-10 md:pt-14"
      role="img"
      aria-label="Un même site affiché sur un téléphone en une colonne, sur un ordinateur en trois colonnes et sur une tablette en deux colonnes"
    >
      <!-- Mobile : une colonne -->
      <div
        class="reveal-screen w-[15%] min-w-0 max-w-[110px] motion-safe:animate-screen-left"
        data-direction="left"
      >
        <div class="rounded-lg border border-border bg-card p-[4%] shadow-sm md:rounded-xl">
          <div class="relative flex aspect-9/17 flex-col gap-[6%] overflow-hidden rounded-md bg-background p-[8%]">
            <span class="absolute top-0 left-1/2 h-[3px] w-[32%] -translate-x-1/2 rounded-b-full bg-border"></span>
            <div class="flex items-center justify-between pt-[10%]">
              <span class="h-[3px] w-[45%] rounded-full bg-primary/40"></span>
              <span class="h-[3px] w-[20%] rounded-full bg-foreground/20"></span>
            </div>
            <div class="grid flex-1 grid-cols-1 gap-[6%]">
              <span class="rounded-sm border border-border bg-card"></span>
              <span class="rounded-sm border border-border bg-card"></span>
              <span class="rounded-sm border border-border bg-card"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Ordinateur : trois colonnes -->
      <div
        class="reveal-screen w-[50%] min-w-0 max-w-[560px] motion-safe:animate-screen-center"
        data-direction="center"
      >
        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
          <div class="flex items-center gap-[1%] border-b border-border bg-muted px-[2.5%] py-[1.2%]">
            <span class="w-[1.4%] aspect-square rounded-full bg-border"></span>
            <span class="w-[1.4%] aspect-square rounded-full bg-border"></span>
            <span class="w-[1.4%] aspect-square rounded-full bg-border"></span>
            <span class="ml-[4%] h-[6px] w-[45%] rounded-full bg-background"></span>
          </div>
          <div class="flex aspect-16/10 flex-col gap-[4%] bg-background p-[5%]">
            <div class="flex items-center justify-between">
              <span class="h-1 w-[16%] rounded-full bg-primary/40"></span>
              <span class="flex w-[30%] items-center gap-[10%]">
                <span class="h-[3px] flex-1 rounded-full bg-foreground/15"></span>
                <span class="h-[3px] flex-1 rounded-full bg-foreground/15"></span>
                <span class="h-[3px] flex-1 rounded-full bg-foreground/15"></span>
              </span>
            </div>
            <div class="flex flex-col gap-[2%]">
              <span class="h-[7px] w-[55%] rounded-full bg-foreground/15"></span>
              <span class="h-[4px] w-[38%] rounded-full bg-foreground/10"></span>
              <span class="mt-[2%] h-[9px] w-[20%] rounded-full bg-primary/30"></span>
            </div>
            <div class="grid flex-1 grid-cols-3 gap-[4%]">
              <span class="rounded-sm border border-border bg-card"></span>
              <span class="rounded-sm border border-border bg-card"></span>
              <span class="rounded-sm border border-border bg-card"></span>
            </div>
          </div>
        </div>
        <div class="mx-auto h-[5px] w-[55%] rounded-b-md bg-border"></div>
      </div>

      <!-- Tablette : deux colonnes -->
      <div
        class="reveal-screen w-[23%] min-w-0 max-w-[250px] motion-safe:animate-screen-right"
        data-direction="right"
      >
        <div class="rounded-lg border border-border bg-card p-[3.5%] pb-[7%] shadow-sm md:rounded-xl">
          <div class="flex aspect-3/4 flex-col gap-[5%] overflow-hidden rounded-md bg-background p-[6%]">
            <div class="flex items-center justify-between">
              <span class="h-[3px] w-[32%] rounded-full bg-primary/40"></span>
              <span class="h-[3px] w-[14%] rounded-full bg-foreground/20"></span>
            </div>
            <div class="flex flex-col gap-[3%]">
              <span class="h-[5px] w-[70%] rounded-full bg-foreground/15"></span>
              <span class="h-[3px] w-[45%] rounded-full bg-foreground/10"></span>
            </div>
            <div class="grid flex-1 grid-cols-2 gap-[5%]">
              <span class="rounded-sm border border-border bg-card"></span>
              <span class="rounded-sm border border-border bg-card"></span>
              <span class="rounded-sm border border-border bg-card"></span>
              <span class="rounded-sm border border-border bg-card"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
