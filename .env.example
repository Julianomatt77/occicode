# Copier ce fichier en .env et renseigner les vraies valeurs.
# .env est ignoré par git (voir .gitignore) : ne jamais commiter de vrais identifiants.
# Utilisé par `npm run deploy` (scripts/deploy.sh).

# Utilisateur + hôte SSH, ex: username@monserveur.hostinger.com
SERVER=

# Dossier distant où déployer le contenu de dist/
# ex: /home/username/domains/occicode.fr/public_html
TARGET_PATH=

# Port SSH (défaut : 22 ; Hostinger utilise souvent un port dédié, ex: 65002)
PORT=22

# Optionnel : chemin vers une clé privée SSH spécifique.
# Si vide, la clé/agent SSH par défaut de la machine est utilisé.
SSH_KEY_PATH=

# "true" pour supprimer côté serveur les fichiers absents de dist/
# (défaut : false, plus prudent)
DEPLOY_DELETE=false

# "true" pour simuler le déploiement sans rien transférer réellement
DEPLOY_DRY_RUN=false
